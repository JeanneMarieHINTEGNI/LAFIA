# Internal static server. TLS, HSTS and the common headers are done by the edge Caddy.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	# Vite assets are content-hashed: cache them forever; the HTML and the PWA entry points must
	# always be revalidated, or browsers keep an old service worker and never see a new deploy.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @html Cache-Control "no-cache"
	file_server
}
